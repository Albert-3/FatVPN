# .NET
backend/**/bin/
backend/**/obj/
*.user

# Secrets
backend/.env
# Local dev secrets — the file used to be committed, so treat the values that
# were in it as public. See appsettings.Development.example.json.
backend/src/FatVpn.Bff.Api/appsettings.Development.json

# Flutter / Dart
app/**/.dart_tool/
app/**/.flutter-plugins
app/**/.flutter-plugins-dependencies
app/**/.packages
app/**/build/
# pubspec.lock is tracked (V30): the app is an application, not a library —
# without the lock the toolchain pin (flutter 3.44.4) reproduces only half the
# build. singbox_mm ships inside this repo and is built only as part of the
# app, so its lock is tracked for the same reason.

# Android
app/**/android/.gradle/
app/**/android/local.properties

# iOS
app/**/ios/Pods/
app/**/ios/.symlinks/
app/**/ios/Flutter/Flutter.podspec

