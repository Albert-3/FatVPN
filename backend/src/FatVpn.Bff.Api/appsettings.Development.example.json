{
  // Copy to appsettings.Development.json (git-ignored) and fill in, or better,
  // use user-secrets so the values never sit in the working tree at all:
  //
  //   cd backend/src/FatVpn.Bff.Api
  //   dotnet user-secrets set "Jwt:Secret" "<32+ random chars>"
  //   dotnet user-secrets set "Bot:Secret" "<random>"
  //   dotnet user-secrets set "Trial:DeviceKeySalt" "<random>"
  //   dotnet user-secrets set "Remnawave:ApiToken" "<panel token>"
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Secret": "REPLACE-WITH-AT-LEAST-32-RANDOM-CHARACTERS"
  },
  "Bot": {
    "Secret": "REPLACE-ME"
  },
  "Trial": {
    "DeviceKeySalt": "REPLACE-ME"
  }
}
