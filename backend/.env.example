# Copy to .env and fill in real values. Never commit .env to git.

# Minimum 32 characters
JWT_SECRET=

# From Remnawave admin panel
REMNAWAVE_API_TOKEN=

# Shared secret between bot and BFF — generate any random string
BOT_SECRET=

# Salt for the trial device-key hash: `openssl rand -hex 32`. Startup refuses to
# boot without it outside Development, so a deploy that forgets it crash-loops —
# it was missing from this file while the server had it, which is the wrong way
# round for a template.
# ⚠️ Changing it re-hashes every device identity, i.e. hands a second trial to
# every install that already spent one.
TRIAL_DEVICE_KEY_SALT=

# Optional. Postgres password; defaults to fatvpn_dev when unset, which is what
# the server has today. Rotating it is two steps in this order — `ALTER USER
# fatvpn WITH PASSWORD '<new>'` in the running container, then this value — see
# docker-compose.yml. Setting it here alone does not change an existing
# database's password, it only stops the BFF from being able to log in.
POSTGRES_PASSWORD=
