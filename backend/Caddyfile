api.fatklyuchi.space {
	# The privacy policy, served from the same name as the API because it is the
	# only name pointed at this host. Both stores require it to sit at a public
	# URL that stays reachable — Apple opens it during review, and Google Play
	# rejects a listing whose policy link 404s — so it lives here rather than on
	# anything that has to be deployed separately.
	#
	# Named matchers rather than inline paths: `handle` takes exactly one matcher
	# token, so `handle /privacy /privacy/` is a config error, and `path` is the
	# thing that accepts a list. Both variants are listed because a link written
	# with a trailing slash must not 404.
	#
	# The Russian block comes first and that ordering matters: `handle` blocks
	# are mutually exclusive and evaluated in file order, so /privacy/ru would
	# otherwise be swallowed by the English one and answered in the wrong
	# language.
	@privacy_ru path /privacy/ru /privacy/ru/
	handle @privacy_ru {
		root * /srv/legal
		rewrite * /privacy.ru.html
		file_server
	}

	@privacy path /privacy /privacy/
	handle @privacy {
		root * /srv/legal
		rewrite * /privacy.html
		file_server
	}

	# Terms of service. Russian first, same reason as the policy above: `handle`
	# blocks are evaluated in file order and /terms/ru would otherwise be
	# swallowed by the English one.
	@terms_ru path /terms/ru /terms/ru/
	handle @terms_ru {
		root * /srv/legal
		rewrite * /terms.ru.html
		file_server
	}

	@terms path /terms /terms/
	handle @terms {
		root * /srv/legal
		rewrite * /terms.html
		file_server
	}

	# The App Store listing's Support URL. One bilingual page, so no /ru twin.
	@support path /support /support/
	handle @support {
		root * /srv/legal
		rewrite * /support.html
		file_server
	}

	handle {
		reverse_proxy bff:5030
	}
}
