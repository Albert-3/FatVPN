<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Local expiry/trial reminder notifications (flutter_local_notifications). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Re-schedule pending reminders after a device reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- No SCHEDULE_EXACT_ALARM: expiry reminders are scheduled inexactly (see
         NotificationService). Asking for it sent the user to a full-screen
         system settings page on first launch, and Google Play reviews it as an
         alarm-clock permission on an app that is not one. -->
    <!-- Backup is off: session tokens and connection settings live in secure
         storage, encrypted with a Keystore key that cannot leave the device.
         Backing the ciphertext up without its key is worse than not backing it
         up at all — the restored install reads garbage (see SecureStore) — and
         a session token is not something to clone onto another phone anyway.
         dataExtractionRules covers the Android 12+ device-to-device transfer,
         which allowBackup alone does not. -->
    <application
        android:label="fatvpn_app"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Deep links are handled manually by the app_links plugin
                 (AuthController). Disable Flutter's built-in deep-link routing so
                 it doesn't try to pushNamed the URI path and crash with an
                 unknown-route assertion. -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Deep link used by the Telegram bot to hand off a short token,
                 e.g. fatvpn://token/AB12CD34 -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="fatvpn"/>
            </intent-filter>
        </activity>
        <!-- Re-schedule flutter_local_notifications reminders after reboot. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="false"/>
        <!-- Home-screen widget. Exported because the launcher (a different app)
             has to be able to send it APPWIDGET_UPDATE — that is what makes a
             widget a widget.

             The two non-widget actions it listens for are both ours and both
             safe to receive from anywhere they could plausibly come from:
             · ACTION_STATE_UPDATE is broadcast by our own VPN service with
               setPackage() *and* a signature-level permission
               (${applicationId}.permission.SIGNBOX_STATE, declared by the
               singbox_mm plugin), so only this app can send it;
             · TOGGLE only ever stops a tunnel or opens the app — the two things
               the user can already do from the notification — and starts
               nothing on its own. -->
        <receiver
            android:name=".widget.FatVpnWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
                <action android:name="com.signbox.singbox_mm.action.STATE"/>
                <action android:name="com.fatvpn.fatvpn_app.widget.action.TOGGLE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/fatvpn_widget_info"/>
        </receiver>
        <!-- The same widget at 2×2. A provider's default size lives in its
             appwidget-provider XML and there is one per receiver, so offering a
             second size in the picker means a second receiver; everything it
             does is inherited from the one above. -->
        <receiver
            android:name=".widget.FatVpnWidgetSquareProvider"
            android:exported="true"
            android:label="@string/widget_name_square">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
                <action android:name="com.signbox.singbox_mm.action.STATE"/>
                <action android:name="com.fatvpn.fatvpn_app.widget.action.TOGGLE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/fatvpn_widget_square_info"/>
        </receiver>
        <!-- Runs the app's own connect logic in a background Flutter engine when
             the widget's power button is tapped with the tunnel down, so
             connecting does not have to open the app (see WidgetConnectService).

             Not exported: it is started only by our own widget provider, and a
             service that can raise a VPN must not be startable by other apps.

             specialUse/vpn, the same type the tunnel service itself declares:
             this exists purely to bring that tunnel up, it lives for the seconds
             that takes, and none of the typed categories (dataSync, sync,
             shortService) describes it any better. -->
        <service
            android:name=".widget.WidgetConnectService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn"/>
        </service>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Visibility of launchable apps for the split-tunneling picker
             (app-drawer apps only, no QUERY_ALL_PACKAGES). -->
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
    </queries>
</manifest>
