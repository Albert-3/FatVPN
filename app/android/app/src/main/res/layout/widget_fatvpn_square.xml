<?xml version="1.0" encoding="utf-8"?>
<!-- Square layout — the 2×2 tile (110dp at the smallest a launcher hands out,
     ~160dp on a real phone).

     Vertical and **centred**, unlike the other two: at two cells wide there is
     no room for a text column beside the power button, so the button goes on
     top and the text under it — and once the button is centred the text has to
     be too. The first build left the text left-aligned under a centred button
     and it read as a mistake on the home screen.

     No status dot here. It is the one thing the other layouts have that this
     one does not need: the power disc is large and central, and it already says
     the same thing in the same colour. It stays in the tree as a GONE view so
     that one drawing routine can fill all three layouts without asking which it
     got (RemoteViews throws when told to touch a view id that is not there).

     Three rows and no more, measured against the smallest 2×2 (110dp):
     6 + 50 + 6 + 18 + 2 + 16 + 6 ≈ 104dp. RemoteViews does not scale what does
     not fit — it clips it — so the fourth row that would carry the location and
     the clock separately is deliberately not here; they share the last line,
     exactly as they do in the compact layout. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="6dp">

    <FrameLayout
        android:id="@+id/widget_power_touch"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/widget_power_ripple">

        <ImageView
            android:id="@+id/widget_power_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:src="@drawable/widget_power_off" />

        <ImageView
            android:id="@+id/widget_power"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="@string/widget_power_description"
            android:src="@drawable/ic_widget_power" />
    </FrameLayout>

    <!-- Present, never shown — see the header. -->
    <ImageView
        android:id="@+id/widget_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:contentDescription="@null"
        android:src="@drawable/widget_dot"
        android:visibility="gone" />

    <!-- match_parent + gravity=center: a TextView only truncates when something
         bounds its width, and "Вы не авторизованы" is wider than a 2×2. -->
    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/widget_status_disconnected"
        android:textColor="@color/widget_text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- The clock shares this line with the location ("🇩🇪 DE 00:12:33"),
             and the call to action replaces both — only ever one of the two
             arrangements is visible (see FatVpnWidgetProvider). -->
        <TextView
            android:id="@+id/widget_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_location_best"
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp" />

        <Chronometer
            android:id="@+id/widget_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/widget_accent"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Weighted so that when it is the only thing on this line (no session,
             no location) it fills the width and centres itself. -->
        <TextView
            android:id="@+id/widget_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/widget_hint_tap_to_connect"
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
