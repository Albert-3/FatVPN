<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext is off everywhere by default. The one exception left is loopback:
     sing-box's local control API, which the health probe queries. It never
     leaves the device, so TLS would buy nothing.

     The BFF's own exception (87.121.221.229) is gone — it moved behind TLS on
     2026-07-30 and the app now talks to https://api.fatklyuchi.space. The old
     address still answers, for builds already on people's phones, but this
     build no longer needs it.

     Keeping the base at false means a future endpoint added by mistake fails
     loudly instead of silently sending tokens in the clear. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
