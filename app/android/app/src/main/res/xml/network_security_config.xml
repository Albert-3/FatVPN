<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext is off everywhere by default. The exceptions below are the only
     two places the app still speaks plain HTTP, and both are temporary:

     * 87.121.221.229 — the test BFF, which has no HTTPS domain yet. This entry
       disappears the moment the BFF moves behind TLS (see api_config.dart).
     * loopback — sing-box's local control API, which the health probe queries.
       It never leaves the device, so TLS would buy nothing.

     Keeping the base at false means a future endpoint added by mistake fails
     loudly instead of silently sending tokens in the clear. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">87.121.221.229</domain>
    </domain-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
