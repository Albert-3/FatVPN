<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The App Group is the widget's only source of data: it reads the snapshot
	     the app and the packet-tunnel extension write there (see
	     ios/Shared/FatVpnWidgetSnapshot.swift). Without this entitlement
	     UserDefaults(suiteName:) returns nil and the widget shows its "open the
	     app" fallback forever — which is why codemagic.yaml verifies the
	     entitlement survived signing on the *exported* .ipa.

	     Deliberately NOT the NetworkExtension entitlement: this widget never
	     talks to the tunnel. Reading NEVPNStatus or calling startVPNTunnel from
	     the widget process would need it, and would make the App ID's
	     capabilities a release blocker on top of everything else. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.fatvpn.fatvpnApp</string>
	</array>
</dict>
</plist>
